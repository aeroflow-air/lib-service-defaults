<Project>
  <!--
    Analyser defaults shipped with AeroFlow.ServiceDefaults (ADR-0022).
    Consuming projects get these via this file (same-repo import or the NuGet
    build / buildTransitive folder). CA1848 / CA2254 come from the SDK analysers.
    BannedApiAnalyzers is a flowing package dependency on the csproj; do not add a
    PackageReference here — restore of this repo would see a duplicate, and a
    PackageReference added only from these props is not restored for consumers
    (0.1.0 packed this file but RS0030 never ran for PackageReference projects).
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CA1848;CA2254;RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
